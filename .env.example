# ========================================================
# PACL Calculator - Environment Configuration Example
# Copy this file to .env and configure your database
# ========================================================

# Database Host (127.0.0.1 for local, or sqlXXX.infinityfree.com for hosting)
DB_HOST=127.0.0.1

# Database Port (3307 for local WampServer MariaDB, 3306 for hosting / MySQL default)
DB_PORT=3307

# Database Name
DB_NAME=pacl_calculator

# Database Username
DB_USER=root

# Database Password (leave blank for local WAMP default)
DB_PASS=

